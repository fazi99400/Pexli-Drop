rules_version = '2';

// Pexli Airdrop — Firestore security rules.
//
// Principle: the browser is NEVER trusted to award points. All point,
// ledger, and config writes happen server-side via Cloud Functions (Admin
// SDK), which bypasses these rules. Clients get read-only access to their
// own data plus the public config, and nothing more.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    // A user may read their own profile. They may NOT write points, ledger
    // cursors, or any verified state — those are function-only. We allow a
    // client create only as a convenience fallback; the canonical create is
    // done by the onCreate auth trigger server-side.
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      // No client writes: profile bootstrap + all mutations are server-side.
      allow write: if isAdmin();
    }

    // Public runtime config (task toggles, point values, locks). Everyone
    // signed in can read it so the UI renders the right tasks. Only admins
    // (and functions) write it.
    match /config/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Append-only audit trail. Read your own rows; never write from client.
    match /pointsLedger/{id} {
      allow read: if isSignedIn() &&
        (resource.data.uid == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // Duplicate-link guard. Function-only.
    match /submittedLinks/{hash} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Tweet pool + assignments — function/admin only.
    match /tweetPool/{id} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    match /tweetAssignments/{id} {
      allow read: if isSignedIn() &&
        (resource.data.uid == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // Everything else: closed by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
