# NON-SECRET function params — committed so CI (firebase deploy --non-interactive)
# has a value for every defineString param. Do NOT put real secrets here (this
# repo is public); use GitHub Secrets + workflow env injection for those.

# --- Chain ---
PEXLI_RPC_URL=https://testrpc.pex.li
PEXLI_EXPLORER_API=https://explorer.pex.li/api
PEXLI_CHAIN_ID=78901

# --- On-chain task targets ---
FAUCET_ADDRESS=0x2431bc9ff07Ad93152f7Cd18566CfC573731f732
TX_TARGET_ADDRESS=0x2431bc9ff07Ad93152f7Cd18566CfC573731f732
DEX_ROUTER_ADDRESS=0x596b93967Cc18539795437A17E689e775c2CCE93

# Faucet signer key (SECRET). Leave EMPTY here — the real key is injected at
# deploy from the GitHub Actions secret named FAUCET_PRIVATE_KEY. Empty = the
# in-app faucet stays disabled (claims return "faucet not funded").
FAUCET_PRIVATE_KEY=

# --- X / Twitter connect (OPTIONAL, free). Create a free X app to enable the
# "Connect X" button: set the two below, and in the X app set the Callback URL
# to exactly the X_REDIRECT_URI value (the xCallback function URL). ---
X_CLIENT_ID=R09LQzVjUEJZYUxOTjkzelFicUw6MTpjaQ
# NEVER put the real secret here (public repo). It is injected at deploy time
# from the GitHub Actions secret named X_CLIENT_SECRET (see the workflow).
X_CLIENT_SECRET=
X_PEXLI_USER_ID=
X_REDIRECT_URI=https://us-central1-pexli-drop.cloudfunctions.net/xCallback
APP_URL=https://drop.pex.li

# --- App ---
ALLOWED_ORIGINS=https://drop.pex.li,https://pexli-drop.pexblock.workers.dev,http://localhost:5173
ADMIN_EMAILS=alamzapakistan@gmail.com

# Empty = HTTP bootstrap disabled; admin is granted automatically via ADMIN_EMAILS.
ADMIN_BOOTSTRAP_TOKEN=
