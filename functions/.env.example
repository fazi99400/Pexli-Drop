# Cloud Functions params — copy to `.env` (git-ignored) for the emulator, or set
# with `firebase functions:config` / `functions:secrets:set` for production.
# Non-secret params can also live in `.env`; secrets must use Secret Manager.

# --- Chain (from https://chainlist.org/chain/78901) ---
PEXLI_RPC_URL=
PEXLI_EXPLORER_API=
PEXLI_CHAIN_ID=78901

# --- On-chain task targets ---
FAUCET_ADDRESS=
DEX_ROUTER_ADDRESS=

# --- X / Twitter OAuth 2.0 ---
X_CLIENT_ID=
X_PEXLI_USER_ID=
X_REDIRECT_URI=https://drop.pex.li/x/callback

# --- App ---
ALLOWED_ORIGINS=https://drop.pex.li,http://localhost:5173

# --- Secrets (set via `firebase functions:secrets:set NAME`, NOT here in prod) ---
# X_CLIENT_SECRET=
# ADMIN_BOOTSTRAP_TOKEN=
