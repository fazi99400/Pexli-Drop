# Firebase web config — copy to `web/.env` (git-ignored). These are NOT secrets
# (they ship in the client bundle), but keep them out of git so forks don't
# point at your project. Values come from Firebase console → Project settings.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Cloud Functions region (must match functions deploy region).
VITE_FUNCTIONS_REGION=us-central1

# Optional: point the SPA at the local emulator suite (true/false).
VITE_USE_EMULATORS=false

# --- Pexli chain (from https://chainlist.org/chain/78901) ---
VITE_PEXLI_RPC_URL=
VITE_PEXLI_EXPLORER_URL=
