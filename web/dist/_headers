# Cloudflare (Pages-style _headers, also honoured by Workers Static Assets).
#
# The PWA manifest and service worker must be served with the right content
# type and caching for the browser to recognize the site as installable and
# to pick up updates promptly — a generic/incorrect type or an aggressively
# cached sw.js is a common reason "Install" silently fails to add a real app
# icon to the home screen.
/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=3600

/sw.js
  Content-Type: application/javascript; charset=utf-8
  Service-Worker-Allowed: /
  Cache-Control: no-cache

/icon-192.png
  Content-Type: image/png
  Cache-Control: public, max-age=604800

/icon-512.png
  Content-Type: image/png
  Cache-Control: public, max-age=604800

/apple-touch-icon.png
  Content-Type: image/png
  Cache-Control: public, max-age=604800
