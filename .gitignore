# Dependencies
node_modules/
*/node_modules/

# Build output
# NOTE: web/dist is intentionally COMMITTED so the Cloudflare Worker can serve
# it directly (its build pipeline runs install + `wrangler deploy` with no build
# step). Rebuild with `npm run build` and commit the result after code changes.
web/.vite/

# Environment / secrets — NEVER commit
.env
.env.local
.env.*.local
web/.env
web/.env.local
functions/.env
functions/.env.local
functions/.runtimeconfig.json
serviceAccountKey.json
*-service-account*.json

# Firebase
.firebase/
.firebaserc
firebase-debug.log
firestore-debug.log
ui-debug.log

# Logs & misc
*.log
.DS_Store
coverage/
